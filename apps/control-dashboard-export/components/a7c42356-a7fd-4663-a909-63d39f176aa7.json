          "value": "{{(function(apiStations, configStations) {\n    // Normalize values to lowercase and create sets for uniqueness\n    const apiSet = new Set( apiStations?.map(station => station.toLowerCase()));\n    const configSet = new Set(configStations?.map(station => station.toLowerCase()));\n    \n    // Merge the two sets\n    const mergedSet = new Set([...apiSet, ...configSet]);\n\n    // Convert back to array with original case from the API data as a priority, and if not, from config\n    const reconciledList = Array.from(mergedSet).map(station => {\n        // Find the original case-sensitive station name from the API or config array\n        const apiMatch = apiStations?.find(s => s.toLowerCase() === station);\n        return apiMatch ? apiMatch : configStations?.find(s => s.toLowerCase() === station);\n    });\n\n    return reconciledList;\n})( queries.58f90d29-0163-4b64-b1b6-63620c1c7ec0.data.swiggy_supported_junctions, variables.STATION_LIST)}}"
